generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model DT_USER {
  nik          String  @id @db.Char(8)
  nama         String  @db.VarChar(40)
  password     String  @db.VarChar(100)
  noTelp       String? @db.VarChar(13)
  email        String? @db.VarChar(100)
  roleId       String  @db.VarChar(20)
  handleWeb    Boolean @default(false)
  statusActive Boolean
  photo        String? @db.VarChar(500)
  departement  String? @db.VarChar(50)
  notificationPrefs   String? @db.NVarChar(Max)
  activeZimbraEmail   String? @db.NVarChar(255)

  //relation
  role               DT_ROLE                  @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forgotPasswords    LOG_FORGOT_PASSWORD[]
  ticketsHandled     DT_TICKET[]              @relation("TicketHandler")
  ticketsCompletedBy DT_TICKET[]              @relation("TicketCompletedBy")
  createdProjects    DT_PROJECT[]             @relation("CreatedProjects")
  createdTasks       DT_TASK[]                @relation("CreatedTasks")
  createdSubTasks    DT_SUB_TASK[]            @relation("CreatedSubTasks")
  memberProjects     DT_MEMBER_PROJECT[]
  assignedTasks      DT_ASSIGNEE_TASK[]       @relation("AssigneeTaskUser")
  assignedSubTasks   DT_ASSIGNEE_SUBTASK[]    @relation("AssigneeSubTaskUser")
  logs               LOG_ACTIVITY[]
  sentInvites        LOG_INVITATION_PROJECT[] @relation("SenderInvites")
  receivedInvites    LOG_INVITATION_PROJECT[] @relation("ReceiverInvites")
  refreshTokens      LOG_REFRESH_TOKEN[]
  mailboxCredentials DT_MAILBOX_CREDENTIAL[]
  chatMemberships    DT_CHAT_MEMBER[]
  chatRoomsCreated   DT_CHAT_ROOM[]           @relation("ChatRoomsCreated")
  pushSubscriptions  DT_PUSH_SUBSCRIPTION[]

}

model DT_ROLE {
  id    String    @id @db.VarChar(20)
  nama  String    @db.VarChar(20)
  users DT_USER[]
}

model DT_TICKET {
  id         String  @id @db.VarChar(20)
  handlerNik String  @db.Char(8)
  handler    DT_USER @relation("TicketHandler", fields: [handlerNik], references: [nik], onDelete: NoAction, onUpdate: NoAction)

  idStore     String  @db.VarChar(20)
  noTelp      String  @db.VarChar(15)
  category    String  @db.VarChar(20)
  status      String  @db.VarChar(15)
  reason      String? @db.VarChar(255)
  description String  @db.VarChar(255)

  fromPayment     String? @db.VarChar(20)
  toPayment       String? @db.VarChar(20)
  isDirectSelling Boolean @default(false)
  idtv            String? @db.VarChar(12)
  billCode        String? @db.VarChar(20)
  grandTotal      String? @db.VarChar(20)

  images DT_IMAGES[] @relation("TicketImages")

  completedByNik String?  @db.Char(8) // ganti nama field, lebih jelas
  completedBy    DT_USER? @relation("TicketCompletedBy", fields: [completedByNik], references: [nik], onDelete: NoAction, onUpdate: NoAction)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([handlerNik])
  @@index([completedByNik])
  @@index([category])
  @@index([status])
}

model DT_IMAGES {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  url       String   @db.VarChar(255)
  filename  String   @db.VarChar(20)
  mimeType  String   @db.VarChar(20)
  createdAt DateTime @default(now())
  bytes     Int

  ticketId String?    @db.VarChar(20)
  ticket   DT_TICKET? @relation("TicketImages", fields: [ticketId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([ticketId])
}

model LOG_FORGOT_PASSWORD {
  otp       String   @id @db.Char(6)
  nik       String   @db.Char(8)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      DT_USER  @relation(fields: [nik], references: [nik], onDelete: Cascade, onUpdate: NoAction)
}

/// ================================
///  PROJECT MANAGEMENT DATABASE SCHEMA
/// ================================
model DT_PROJECT {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  name      String   @db.VarChar(100)
  desc              String?  @db.VarChar(255)
  color             String?  @db.VarChar(30)
  icon              String?  @db.NVarChar(500)
  isPrivate         Boolean  @default(false)
  defaultPermission String   @default("EDITOR") @db.VarChar(20)
  createdBy         String   @db.Char(8)
  createdAt DateTime @default(now())
  isArchive Boolean  @default(false)
  shortId   String?  @unique @db.VarChar(12)
  user      DT_USER  @relation("CreatedProjects", fields: [createdBy], references: [nik], onDelete: NoAction, onUpdate: NoAction)

  // Relasi ke data lain
  members     DT_MEMBER_PROJECT[]
  views       DT_VIEWS[]
  sections    DT_SECTION[] // Cascade dari Project → Section
  tasks       DT_TASK[] // NoAction (hindari cyclic cascade)
  tags        DT_TAG[]                 @relation("ProjectTags")
  activities  LOG_ACTIVITY[]
  invitations LOG_INVITATION_PROJECT[]
}

/// ================================
///  PROJECT VIEWS
/// ================================
model DT_VIEWS {
  id        String     @id @default(uuid()) @db.UniqueIdentifier
  projectId String     @db.UniqueIdentifier
  name      String     @db.VarChar(100)
  type      String     @db.VarChar(50)
  rank      String     @default("8000000000000000") @db.VarChar(32)
  shortId   String?    @unique @db.VarChar(12)
  settings  String?    @db.NVarChar(Max)

  // Relasi
  project DT_PROJECT @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks   DT_TASK[]

  @@index([projectId])
}

/// ================================
///  MEMBER MANAGEMENT
/// ================================
model DT_MEMBER_PROJECT {
  id                 String @id @default(uuid()) @db.UniqueIdentifier
  projectId          String @db.UniqueIdentifier
  nik                String @db.Char(8)
  id_dt_project_role String @db.VarChar(20)

  // Relations
  project     DT_PROJECT      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        DT_USER         @relation(fields: [nik], references: [nik], onDelete: Cascade, onUpdate: NoAction)
  roleProject DT_PROJECT_ROLE @relation(fields: [id_dt_project_role], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// ================================
///  ROLE
/// ================================
model DT_PROJECT_ROLE {
  id      String              @id @db.VarChar(20)
  name    String              @db.VarChar(50)
  members DT_MEMBER_PROJECT[]
}

/// ================================
///  TASK
/// ================================
model DT_TASK {
  id            String             @id @default(uuid()) @db.UniqueIdentifier
  name          String             @db.VarChar(100)
  createdBy     String             @db.Char(8)
  desc          String?            @db.VarChar(100)
  dueDate       DateTime?
  status        Boolean            @default(false)
  doneDate      DateTime?
  createdAt     DateTime           @default(now())
  id_dt_project String             @db.UniqueIdentifier
  id_dt_section String?            @db.UniqueIdentifier
  id_dt_view    String?            @db.UniqueIdentifier
  assignees     DT_ASSIGNEE_TASK[]

  rank String? @db.VarChar(16)
  shortId String? @unique @db.VarChar(12)
  customFields String? @db.NVarChar(Max)

  project     DT_PROJECT           @relation(fields: [id_dt_project], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     DT_USER              @relation("CreatedTasks", fields: [createdBy], references: [nik], onDelete: NoAction, onUpdate: NoAction)
  section     DT_SECTION?          @relation(fields: [id_dt_section], references: [id], onDelete: Cascade, onUpdate: NoAction)
  view        DT_VIEWS?            @relation(fields: [id_dt_view], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments DT_TASK_ATTACHMENT[] @relation("TaskAttachment")
  subTask     DT_SUB_TASK[]
  tags        DT_TAG[]
  logs        LOG_ACTIVITY[]
  chatPinned  DT_CHAT_PINNED_TASK[]

  @@index([id_dt_project])
  @@index([id_dt_section])
  @@index([id_dt_view])
  @@index([rank])
  @@index([createdBy])
}

model DT_TASK_ATTACHMENT {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  url       String   @db.VarChar(255)
  filename  String   @db.VarChar(20)
  mimeType  String   @db.VarChar(20)
  createdAt DateTime @default(now())
  bytes     Int

  taskId String?  @db.UniqueIdentifier
  task   DT_TASK? @relation("TaskAttachment", fields: [taskId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([taskId])
}

/// ================================
///  SUBTASK
/// ================================
model DT_SUB_TASK {
  id           String                @id @default(uuid()) @db.UniqueIdentifier
  name         String                @db.VarChar(100)
  id_dt_task   String                @db.UniqueIdentifier
  // Nullable so existing rows stay intact; backfill from parent task.createdBy
  createdBy    String?               @db.Char(8)
  dueDate      DateTime?
  doneDate     DateTime?
  createdAt    DateTime              @default(now())
  rank         String?               @db.VarChar(16)
  status       Boolean               @default(false)
  customFields String?               @db.NVarChar(Max)
  // Relations
  task         DT_TASK               @relation(fields: [id_dt_task], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator      DT_USER?              @relation("CreatedSubTasks", fields: [createdBy], references: [nik], onDelete: NoAction, onUpdate: NoAction)
  assignees    DT_ASSIGNEE_SUBTASK[]

  @@index([createdBy])
}

/// ================================
///  TASK ASSIGNEE
/// ================================
model DT_ASSIGNEE_TASK {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  taskId     String   @db.UniqueIdentifier
  nik        String   @db.Char(8)
  assignedAt DateTime @default(now())

  task DT_TASK @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // RELASI BERNAMA → "AssigneeTaskUser"
  user DT_USER @relation("AssigneeTaskUser", fields: [nik], references: [nik], onDelete: NoAction, onUpdate: NoAction)

  @@unique([taskId, nik])
  @@index([nik])
}

model DT_ASSIGNEE_SUBTASK {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  subTaskId  String   @db.UniqueIdentifier
  nik        String   @db.Char(8)
  assignedAt DateTime @default(now())

  subTask DT_SUB_TASK @relation(fields: [subTaskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // RELASI BERNAMA → "AssigneeSubTaskUser"
  user    DT_USER     @relation("AssigneeSubTaskUser", fields: [nik], references: [nik], onDelete: NoAction, onUpdate: NoAction)

  @@unique([subTaskId, nik])
  @@index([nik])
}

/// ================================
///  SECTION
/// ================================
model DT_SECTION {
  id            String     @id @default(uuid()) @db.UniqueIdentifier
  id_dt_project String     @db.UniqueIdentifier
  name          String     @db.VarChar(100)
  rank          String     @default("8000000000000000") @db.VarChar(32)
  category      String     @default("active") @db.VarChar(20)
  // Relasi ke Project
  project       DT_PROJECT @relation(fields: [id_dt_project], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Relasi ke Task
  tasks DT_TASK[]

  @@index([id_dt_project])
}

/// ================================
///  TAG
/// ================================
model DT_TAG {
  id            String  @id @default(uuid()) @db.UniqueIdentifier
  id_dt_task    String? @db.UniqueIdentifier
  id_dt_project String  @db.UniqueIdentifier
  name          String  @db.VarChar(50)

  task    DT_TASK?   @relation(fields: [id_dt_task], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project DT_PROJECT @relation("ProjectTags", fields: [id_dt_project], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_dt_project])
  @@index([id_dt_task])
}

/// ================================
///  LOGS
/// ================================
model LOG_ACTIVITY {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  projectId String   @db.UniqueIdentifier
  taskid    String?  @db.UniqueIdentifier
  nik       String   @db.Char(8)
  action    String   @db.VarChar(255)
  details   String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())

  project DT_PROJECT @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task    DT_TASK?   @relation(fields: [taskid], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user    DT_USER    @relation(fields: [nik], references: [nik], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId])
  @@index([taskid])
  @@index([nik])
  @@index([createdAt])
}

model LOG_INVITATION_PROJECT {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  sender    String    @db.Char(8)
  to        String    @db.Char(8)
  projectId String    @db.UniqueIdentifier
  status    String?   @db.VarChar(50)
  asRole    String?   @db.VarChar(20)
  expire    DateTime?

  project      DT_PROJECT @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  senderUser   DT_USER    @relation("SenderInvites", fields: [sender], references: [nik], onDelete: NoAction, onUpdate: NoAction)
  receiverUser DT_USER    @relation("ReceiverInvites", fields: [to], references: [nik], onDelete: NoAction, onUpdate: NoAction)
}

model LOG_REFRESH_TOKEN {
  id         String   @id @db.VarChar(64)
  nik        String   @db.Char(8)
  family     String   @db.VarChar(64)
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userAgent  String?  @db.NVarChar(500)
  deviceHash String?  @db.VarChar(64)

  user DT_USER @relation(fields: [nik], references: [nik], onDelete: Cascade, onUpdate: NoAction)

  @@index([nik])
  @@index([family])
  @@index([nik, deviceHash])
}

model DT_PUSH_SUBSCRIPTION {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  nik          String   @db.Char(8)
  endpoint     String   @db.NVarChar(Max)
  endpointHash String   @unique @db.VarChar(64)
  p256dh       String   @db.NVarChar(255)
  auth         String   @db.NVarChar(255)
  userAgent    String?  @db.NVarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user DT_USER @relation(fields: [nik], references: [nik], onDelete: Cascade, onUpdate: NoAction)

  @@index([nik])
}

/// ================================
///  CHAT
/// ================================
model DT_CHAT_ROOM {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  type          String    @db.VarChar(10) // dm | group
  name          String?   @db.VarChar(100)
  emoji         String?   @db.NVarChar(16)
  color         String?   @db.VarChar(30)
  createdBy     String    @db.Char(8)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  /// sorted "nikA|nikB" for DM dedupe; null for groups
  dmKey         String?   @unique @db.VarChar(20)

  creator     DT_USER              @relation("ChatRoomsCreated", fields: [createdBy], references: [nik], onDelete: NoAction, onUpdate: NoAction)
  members     DT_CHAT_MEMBER[]
  messages    DT_CHAT_MESSAGE[]
  pinnedTasks DT_CHAT_PINNED_TASK[]

  @@index([type])
  @@index([lastMessageAt])
  @@index([createdBy])
}

model DT_CHAT_MEMBER {
  roomId             String   @db.UniqueIdentifier
  nik                String   @db.Char(8)
  role               String   @default("member") @db.VarChar(10) // owner | member
  joinedAt           DateTime @default(now())
  isPinned           Boolean  @default(false)
  isMuted            Boolean  @default(false)
  showTaskPanel      Boolean  @default(false)
  lastReadMessageId  String?  @db.UniqueIdentifier
  unreadCount        Int      @default(0)

  room DT_CHAT_ROOM @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user DT_USER      @relation(fields: [nik], references: [nik], onDelete: Cascade, onUpdate: NoAction)

  @@id([roomId, nik])
  @@index([nik])
}

model DT_CHAT_MESSAGE {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  roomId        String    @db.UniqueIdentifier
  /// "system" for system messages — no FK (not a real user nik)
  senderNik     String    @db.VarChar(20)
  type          String    @default("text") @db.VarChar(10) // text | task | system | file
  content       String    @db.NVarChar(Max)
  taskRefJson   String?   @db.NVarChar(Max)
  attachmentsJson String? @db.NVarChar(Max)
  replyToId     String?   @db.UniqueIdentifier
  reactionsJson String?   @db.NVarChar(Max)
  readByJson    String?   @db.NVarChar(Max)
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  deletedAt     DateTime?

  room DT_CHAT_ROOM @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([roomId, createdAt])
  @@index([senderNik])
}

model DT_CHAT_PINNED_TASK {
  roomId       String    @db.UniqueIdentifier
  taskId       String    @db.UniqueIdentifier
  projectId    String    @db.UniqueIdentifier
  projectName  String    @db.VarChar(100)
  projectColor String?   @db.VarChar(30)
  name         String    @db.VarChar(100)
  status       Boolean   @default(false)
  dueDate      DateTime?
  pinnedAt     DateTime  @default(now())
  pinnedBy     String    @db.Char(8)

  room DT_CHAT_ROOM @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task DT_TASK      @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roomId, taskId])
  @@index([taskId])
}

model DT_MAILBOX_CREDENTIAL {
  id                 String    @id @db.VarChar(36)
  nik                String    @db.Char(8)
  zimbraEmail        String    @db.NVarChar(255)
  displayName        String?   @db.NVarChar(255)
  passwordCipher     String    @db.NVarChar(Max)
  passwordIv         String    @db.VarChar(64)
  passwordTag        String    @db.VarChar(64)
  authToken          String?   @db.NVarChar(Max)
  authTokenExpiresAt DateTime?
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  user DT_USER @relation(fields: [nik], references: [nik], onDelete: Cascade, onUpdate: NoAction)

  @@unique([nik, zimbraEmail])
  @@index([nik])
}

